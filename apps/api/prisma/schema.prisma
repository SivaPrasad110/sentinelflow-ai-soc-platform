// SentinelFlow Prisma Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  NEW
  TRIAGED
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

enum IOCType {
  IP
  DOMAIN
  HASH_SHA256
  HASH_MD5
  URL
  EMAIL
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum UserRole {
  ANALYST
  SOC_LEAD
  ADMIN
}

model Organization {
  id               String                   @id @default(uuid())
  name             String
  slug             String                   @unique
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  memberships      OrganizationMembership[]
  incidents        Incident[]
  alerts           SecurityAlert[]
  incidentAnalyses IncidentAnalysis[]
}

model OrganizationMembership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           Role         @default(ANALYST)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model User {
  id                String                   @id @default(uuid())
  email             String                   @unique
  name              String
  passwordHash      String?
  role              UserRole                 @default(ANALYST)
  tenantId          String                   @default("default-tenant")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  incidents         Incident[]
  memberships       OrganizationMembership[]
  refreshSessions   RefreshSession[]
  triggeredAnalyses IncidentAnalysis[]

  @@index([tenantId])
}

model RefreshSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model SecurityAlert {
  id             String        @id @default(uuid())
  title          String
  description    String
  severity       Severity      @default(MEDIUM)
  source         String
  rawPayload     Json?
  tenantId       String        @default("default-tenant")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  detectedAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  incidentId     String?
  incident       Incident?     @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([organizationId])
  @@index([severity])
  @@index([incidentId])
  @@index([detectedAt])
}

model Incident {
  id                 String                  @id @default(uuid())
  title              String
  description        String
  severity           Severity                @default(MEDIUM)
  status             IncidentStatus          @default(NEW)
  tenantId           String                  @default("default-tenant")
  organizationId     String?
  organization       Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedToId       String?
  assignedTo         User?                   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  alerts             SecurityAlert[]
  iocs               IndicatorOfCompromise[]
  aiSummary          String?
  aiRiskScore        Float?
  mitigationSteps    String[]
  aiAnalysis         Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  workflowExecutions WorkflowExecutionLog[]
  analyses           IncidentAnalysis[]

  @@index([tenantId])
  @@index([organizationId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model IndicatorOfCompromise {
  id           String    @id @default(uuid())
  type         IOCType
  value        String
  threatScore  Float?
  enrichedData Json?
  incidentId   String
  incident     Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([incidentId])
  @@index([value])
  @@index([type])
}

model WorkflowExecutionLog {
  id            String    @id @default(uuid())
  workflowId    String
  executionId   String
  status        String
  outputSummary String?
  incidentId    String
  incident      Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  triggeredAt   DateTime  @default(now())
  completedAt   DateTime?

  @@index([incidentId])
  @@index([workflowId])
}

enum AnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TriageSeverity {
  INFORMATIONAL
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model IncidentAnalysis {
  id                  String          @id @default(uuid())
  incidentId          String
  incident            Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status              AnalysisStatus  @default(PENDING)
  eventId             String          @unique
  workflowId          String?
  executionId         String?
  model               String?
  summary             String?
  severityAssessment  TriageSeverity?
  confidence          Float?
  evidence            String[]        @default([])
  potentialImpact     String?
  recommendedActions  String[]        @default([])
  missingInformation  String[]        @default([])
  requiresHumanReview Boolean         @default(true)
  errorMessage        String?
  rawResponse         Json?
  durationMs          Int?
  triggeredById       String?
  triggeredBy         User?           @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now())
  completedAt         DateTime?

  @@index([incidentId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([eventId])
}
