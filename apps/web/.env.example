#   Vercel production: https://sentinelflow-api-ohio.onrender.com/api/v1
VITE_API_BASE_URL="https://sentinelflow-api-ohio.onrender.com/api/v1"
VITE_APP_TITLE="SentinelFlow SOC Platform"
