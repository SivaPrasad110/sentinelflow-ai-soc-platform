# ==============================================================================
# SentinelFlow — Production Environment Variables Template
# (.env.production.example)
#
# IMPORTANT RULES:
#  1. Copy this file to '.env.production' — NEVER commit .env.production to git.
#  2. All values marked [REQUIRED] MUST be replaced before deployment.
#  3. All values marked [GENERATE] must be generated using the command shown.
#  4. Values marked [OPTIONAL] have sensible defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime Mode
# ------------------------------------------------------------------------------
NODE_ENV=production

# Port the NestJS API listens on inside the container (NGINX proxies externally)
PORT=3000

# Exact frontend origin(s). Comma-separate multiple origins:
# CORS_ORIGIN=https://app.yourdomain.com,https://www.yourdomain.com
# [REQUIRED] Replace with your actual domain
CORS_ORIGIN=https://app.yourdomain.com

# ------------------------------------------------------------------------------
# Managed PostgreSQL (NO local postgres in production!)
# Get your connection string from: Railway / Supabase / Render / Neon
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# [REQUIRED] Replace with your managed database connection string
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://sentinelflow_user:REPLACE_ME@your-db-host.provider.com:5432/sentinelflow_prod?sslmode=require"

# ------------------------------------------------------------------------------
# JWT Authentication Secrets
#
# [GENERATE] Run: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
# Min entropy: 256 bits (32 bytes). Must be different from development secret.
# [REQUIRED] Replace with a generated secret
# ------------------------------------------------------------------------------
JWT_SECRET=REPLACE_ME_WITH_GENERATED_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=15m

# ------------------------------------------------------------------------------
# n8n Cloud Automation Integration
# [REQUIRED] Set to your n8n Cloud webhook URL
# [REQUIRED] Set to the shared secret configured in your n8n webhook node
# ------------------------------------------------------------------------------
N8N_WEBHOOK_URL="https://YOUR-INSTANCE.app.n8n.cloud/webhook/sentinelflow/incident-triage"
N8N_WEBHOOK_SECRET=REPLACE_ME_WITH_N8N_SHARED_SECRET

# ------------------------------------------------------------------------------
# Frontend (Vite Build-Time Variables)
# These are baked into the SPA bundle at build time — do NOT include secrets.
# Set VITE_API_BASE_URL to your API's public HTTPS URL.
# [REQUIRED] Replace with your actual API domain
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="https://api.yourdomain.com/api/v1"
VITE_APP_TITLE="SentinelFlow SOC Platform"

# ------------------------------------------------------------------------------
# Optional Observability
# [OPTIONAL] Uncomment and set if using an external log aggregator
# ------------------------------------------------------------------------------
# LOG_LEVEL=info
# SENTRY_DSN=https://...@sentry.io/...
