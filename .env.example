# ==============================================================================
# SentinelFlow Environment Configuration (.env.example)
# Production-oriented AI Security Operations Platform
#
# IMPORTANT:
# - Copy this file to '.env' in your local development environment.
# - Do NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL + Prisma)
# Default points to local PostgreSQL instance (or Docker container)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinelflow_dev?schema=public"

# Database container settings (for Docker Compose local development)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sentinelflow_dev
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Authentication & Security Tokens (Development Placeholders)
# ------------------------------------------------------------------------------
JWT_SECRET=development_sentinelflow_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=1d

# ------------------------------------------------------------------------------
# n8n Automation Engine Integration
# Used by NestJS to dispatch triage workflows and receive execution callbacks
# ------------------------------------------------------------------------------
# Webhook URL provided by n8n Cloud or local n8n instance
N8N_WEBHOOK_URL="https://your-n8n-cloud-instance.app.n8n.cloud/webhook/sentinelflow/incident-triage"
# Secret token shared between SentinelFlow and n8n to verify webhook authenticity
N8N_WEBHOOK_SECRET=development_n8n_webhook_secret_key

# ------------------------------------------------------------------------------
# Frontend Application Configuration (apps/web)
# Vite requires environment variables to be prefixed with VITE_
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="http://localhost:3000/api/v1"
VITE_APP_TITLE="SentinelFlow SOC Platform"
